{
  "name": "taurus-k9-portal",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=22.14"
  },
  "scripts": {
    "dev": "npm run build && wrangler dev",
    "build": "node scripts/build.mjs && tsc --noEmit",
    "lint": "eslint server/worker scripts tests/worker.test.js portal/js/client.js",
    "test": "node --experimental-strip-types --test server/agreement-mapping.test.cjs tests/worker.test.js",
    "db:migrate:local": "wrangler d1 migrations apply portal-db --local",
    "check": "npm run build && npm run lint && npm test"
  },
  "dependencies": {
    "oauth4webapi": "^3.8.8"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "^5.20261019.1",
    "@eslint/js": "^10.0.1",
    "eslint": "^10.13.0",
    "globals": "^17.13.0",
    "miniflare": "^5.20261019.0-beta",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.72.0",
    "wrangler": "^4.151.2"
  }
}
