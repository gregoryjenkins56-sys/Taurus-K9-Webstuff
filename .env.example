# Copy to .dev.vars (ignored) for Wrangler local development.
# No provider secrets in frontend code.
APP_ENV=
APP_ORIGIN=
AUTH_ISSUER=
AUTH_CLIENT_ID=
AUTH_CLIENT_SECRET=
# Callback is derived as APP_ORIGIN + /api/auth/callback; register it with Auth0.
# D1 is a Worker binding in wrangler.jsonc, not an environment URL or password.
# Veterinary uploads, HubSpot and Adobe are NOT implemented or configured.
