{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "taurus-k9-webstuff",
  "main": "server/worker/index.ts",
  "compatibility_date": "2026-10-19",
  "workers_dev": false,
  "preview_urls": false,
  "assets": {
    "directory": "./dist",
    "binding": "ASSETS",
    "run_worker_first": true
  },
  "observability": {
    "logs": {
      "enabled": true,
      "head_sampling_rate": 1,
      "invocation_logs": true,
      "persist": true
    },
    "traces": {
      "enabled": false,
      "head_sampling_rate": 1,
      "persist": true
    }
  },
  "vars": {
    "APP_ENV": "production",
    "APP_ORIGIN": "https://taurus-k9-webstuff.taurusk9tx.workers.dev",
    "AUTH_ISSUER": "https://dev-an352s76u7pyqmzz.us.auth0.com/",
    "AUTH_CLIENT_ID": "u1mhjXUkU3tUcBwXd4K9mnM5suq6G1MI"
  },
  // Retained legacy/default mapping for compatibility, not a preview/production alias.
  // Local commands must use --local; remote operations must select an explicit --env.
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "taurus-k9-webstuff",
      "database_id": "1a11389d-19cd-4777-9ed7-f397aa6ceb86",
      "migrations_dir": "migrations"
    }
  ],
  "env": {
    "preview": {
      "name": "taurus-k9-webstuff",
      "workers_dev": true,
      "preview_urls": false,
      "vars": {
        "APP_ENV": "preview",
        "APP_ORIGIN": "https://taurus-k9-webstuff.taurusk9tx.workers.dev",
        "AUTH_ISSUER": "https://dev-an352s76u7pyqmzz.us.auth0.com/",
        "AUTH_CLIENT_ID": "u1mhjXUkU3tUcBwXd4K9mnM5suq6G1MI"
      },
      "d1_databases": [
        {
          "binding": "DB",
          "database_name": "taurus-k9-webstuff-preview",
          // Replace with the verified preview UUID before remote use. See docs/phase2-setup.md.
          "database_id": "1a11389d-19cd-4777-9ed7-f397aa6ceb86",
          "migrations_dir": "migrations"
        }
      ]
    },
    "production": {
      "name": "taurus-k9-webstuff-production",
      "workers_dev": false,
      "preview_urls": false,
      "vars": {
        "APP_ENV": "production",
        "APP_ORIGIN": "https://taurus-k9-webstuff-production.workers.dev",
        "AUTH_ISSUER": "https://dev-an352s76u7pyqmzz.us.auth0.com/",
        "AUTH_CLIENT_ID": "u1mhjXUkU3tUcBwXd4K9mnM5suq6G1MI"
      },
      "d1_databases": [
        {
          "binding": "DB",
          "database_name": "taurus-k9-webstuff-production",
          // Replace with a distinct, verified production UUID before remote use.
          "database_id": "1a11389d-19cd-4777-9ed7-f397aa6ceb86",
          "migrations_dir": "migrations"
        }
      ]
    }
  }
}
